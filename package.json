{
  "name": "spokflow",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "preandroid": "set SPOKFLOW_TEST_BUILD=1&& npm run apk",
    "android": "expo run:android --variant release --no-bundler --binary android/app/build/outputs/apk/release/app-release.apk",
    "android:dev": "node scripts/with-native-engine.js expo run:android",
    "preios": "node scripts/check-release-config.cjs --platform ios",
    "ios": "expo run:ios --configuration Release --no-bundler",
    "ios:dev": "expo run:ios",
    "preapk": "node scripts/check-release-config.cjs --platform android && node scripts/verify-model.js --check && expo prebuild --platform android --no-install",
    "apk": "node scripts/with-native-engine.js android\\gradlew.bat -p android :app:assembleRelease",
    "postapk": "npm run verify-apk",
    "verify-apk": "node scripts/with-native-engine.js node scripts/verify-artifact.cjs",
    "preinstall-apk": "npm run verify-apk",
    "install-apk": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "open:android": "adb shell am start -n com.spokflow.app/.MainActivity",
    "fetch-model": "node scripts/verify-model.js --download",
    "eas-build-pre-install": "node scripts/check-release-config.cjs && node scripts/verify-model.js --download",
    "typecheck": "tsc --noEmit",
    "check:signing": "node scripts/with-native-engine.js node scripts/verify-bundle-signature.check.cjs",
    "check": "node scripts/dependency-compat.check.cjs && node src/lib/engine.check.cjs && node src/lib/whisperEngine.check.cjs && node src/lib/entitlement.check.cjs && node src/lib/storePlans.check.cjs && node src/db/database.check.cjs && node scripts/verify-model.check.cjs && node scripts/verify-artifact.check.cjs && node scripts/with-release-signing.check.cjs && node scripts/with-data-protection.check.cjs && node scripts/with-native-engine.check.cjs && node scripts/with-stable-android-build.check.cjs",
    "lint": "expo lint",
    "postinstall": "node scripts/fix-audio-capture.cjs && node scripts/fix-whisper-decoder.cjs && node scripts/fix-query-decoder.cjs && node scripts/fix-expo-prebuild.cjs && node scripts/verify-model.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@fugood/react-native-audio-pcm-stream": "1.1.4",
    "buffer": "6.0.3",
    "expo": "57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "10.9.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "whisper.rn": "0.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "26.4.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.13",
    "eslint-config-expo": "~57.0.2",
    "sucrase": "3.35.1",
    "typescript": "~6.0.3",
    "yauzl": "3.4.0"
  },
  "private": true,
  "overrides": {
    "postcss": "8.5.28",
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  }
}
